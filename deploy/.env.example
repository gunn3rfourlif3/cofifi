# Copy to .env, fill in, and chmod 600. .env is gitignored — never commit the
# filled-in one.

SITE_URL=https://cofifi.com

# The Caddy that already fronts this VPS lives on this docker network. COFiFi
# joins it; it is never created or removed by us. `docker inspect <caddy> ...`
# if it is ever renamed.
PROXY_NETWORK=deploy_default

DB_NAME=cofifi
DB_USER=cofifi
DB_PASSWORD=
DB_ROOT_PASSWORD=

# true  = live, but everyone sees the holding page (this is how you go live)
# false = shop open
MAINTENANCE=true

# Only read by first-run.sh, only on the very first run.
ADMIN_USER=cofifi
ADMIN_EMAIL=hello@cofifi.com
ADMIN_PASSWORD=
