# Copy to .env and fill in. .env is gitignored — never commit the real one.

SITE_URL=https://cofifi.com

# Loopback port the host's reverse proxy forwards to. Pick one nothing else uses.
HTTP_PORT=8081

DB_NAME=cofifi
DB_USER=cofifi
DB_PASSWORD=
DB_ROOT_PASSWORD=

# true  = live, but everyone sees the holding page (this is how you go live)
# false = shop open
MAINTENANCE=true

# Only read by first-run.sh, only on the very first run.
ADMIN_USER=cofifi
ADMIN_EMAIL=hello@cofifi.com
ADMIN_PASSWORD=
